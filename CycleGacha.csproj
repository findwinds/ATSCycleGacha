<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>CycleGacha</AssemblyName>
    <RootNamespace>Forwindz.CycleGacha</RootNamespace>
    <Description>Win settlements for draw tickets, then spin a cycle-wide gacha for resources, population and percentage buffs.</Description>
    <Version>0.14.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <DebugType>Full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <!-- Removed BepInEx.PluginInfoProps: it generates Forwindz.CycleGacha.PluginInfo
         (CS0101 duplicate) and Scripts/Plugin.cs already declares it. -->
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.15" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <Reference Include="$(StormPath)/Against the Storm_Data/Managed/Assembly-CSharp.dll" Publicize="true" />
    <Reference Include="API">
      <HintPath>$(BepInExPath)\BepInEx\plugins\ATS_API_Devs-API\API.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(StormPath)\Against the Storm_Data\Managed\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(StormPath)\Against the Storm_Data\Managed\UniTask.dll</HintPath>
    </Reference>
    <!-- Required by the game's own types: SO derives from SerializedScriptableObject (Sirenix),
         and ATS_API.Hotkeys exposes Unity.InputSystem callback signatures. -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(StormPath)\Against the Storm_Data\Managed\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>$(StormPath)\Against the Storm_Data\Managed\Sirenix.Utilities.dll</HintPath>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(StormPath)\Against the Storm_Data\Managed\Unity.InputSystem.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="ModPackageInfo\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build">
    <ItemGroup>
      <Assembly Include="$(OutputPath)$(AssemblyName).dll" />
      <MetaFile Include="ModPackageInfo\*.*" />
      <MetaFile Include="README.md" />
    </ItemGroup>

    <Copy SourceFiles="@(Assembly)" DestinationFolder="$(BepInExPath)\BepInEx\plugins\Forwindz-CycleGacha\" />
    <Copy SourceFiles="@(MetaFile)" DestinationFolder="$(BepInExPath)\BepInEx\plugins\Forwindz-CycleGacha\" />
  </Target>

</Project>
